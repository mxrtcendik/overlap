{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "overlap",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "overlap",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "VOTE_LIMITER", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
    { "name": "OWNER_LIMITER", "namespace_id": "4103", "simple": { "limit": 30, "period": 60 } },
    { "name": "EMAIL_LIMITER", "namespace_id": "4104", "simple": { "limit": 3, "period": 60 } }
  ],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["links@overlap.cendik.dev"] }],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "overlap"
    }
  ]
}
