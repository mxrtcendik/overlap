{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "overlap",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "TURNSTILE_HOSTNAMES": "overlap.cendik.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "overlap",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "POLL_ROOM", "class_name": "PollRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PollRoom"] }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "VOTE_LIMITER", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
    { "name": "OWNER_LIMITER", "namespace_id": "4103", "simple": { "limit": 30, "period": 60 } }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "overlap"
    }
  ]
}
